# ==============================================================================
# 智筛招聘环境配置模板 (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础与安全配置 (Django Core)
# ------------------------------------------------------------------------------
# 本地单机开发使用 config.settings.development；Docker 生产部署使用 config.settings.production (由 compose.yaml 自动指定)
DJANGO_SETTINGS_MODULE=config.settings.development
# 生产环境必须替换为长随机字符串（至少 50 字符）
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters

# 允许访问的主机名/IP。生产环境必须加入服务器实际 IP 或域名，多个用英文逗号分隔：
# 例如：DJANGO_ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF 受信任来源（无网关直连时必须配置带端口的完整 URL，否则登录/POST 报 403 Forbidden）：
# 例如：DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.100:8000
DJANGO_CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. 数据库与缓存 (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# 本地开发默认 SQLite：sqlite:///db.sqlite3
# Docker 生产中将自动使用 compose.yaml 注入的 PostgreSQL 地址
DATABASE_URL=sqlite:///db.sqlite3
# Docker Compose PostgreSQL 密码（必须设置强密码）
POSTGRES_PASSWORD=replace-with-strong-db-password
# Redis 消息队列与缓存地址
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. 异步任务与后台处理 (Celery & Background Tasks)
# ------------------------------------------------------------------------------
# 本地开发可设为 true；Docker 生产模式由 compose.yaml 自动强制设为 false 启用 Celery Worker
CELERY_TASK_ALWAYS_EAGER=true
LOCAL_BACKGROUND_TASKS=true

# ------------------------------------------------------------------------------
# 4. 对象存储 (MinIO / S3)
# ------------------------------------------------------------------------------
# 本地开发为 false；Docker 生产模式由 compose.yaml 自动设为 true
USE_S3_STORAGE=false
# MinIO / S3 访问凭据（注意：密码至少 8 字符）
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=smart-screening
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 5. 初始管理员与预置资料 (Bootstrap)
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
# 首次启动必填初始管理员密码
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-initial-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SEED_INITIAL_REFERENCE=true
INITIAL_REFERENCE_DOCUMENT_PATH=/app/docs/招聘信息汇总.docx

# ------------------------------------------------------------------------------
# 6. 大模型服务配置 (AI Analysis)
# ------------------------------------------------------------------------------
MODEL_API_KEY=
MODEL_BASE_URL=https://ai.libibi.top/v1
MODEL_NAME=gpt-5.6-sol
MODEL_REQUEST_TIMEOUT=90
AUTO_GENERATE_INITIAL_RULES=true
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0

# ------------------------------------------------------------------------------
# 7. 北森 OpenAPI 集成 (iTalent)
# ------------------------------------------------------------------------------
ITALENT_APP_KEY=
ITALENT_APP_SECRET=
ITALENT_BASE_URL=https://openapi.italent.cn
ITALENT_APPLICATIONS_ENDPOINT=/RecruitV6/api/v1/Apply/GetApplyListByApplicantId
ITALENT_POSITIONS_ENDPOINT=/RecruitV6/api/v1/Job/GetJobListByIds
ITALENT_REQUIREMENTS_ENDPOINT=
ITALENT_APPLICATION_FIELDS=InitialSubmissionDate,InitialSubmissionChannel,InitialSubmissionMedium,BelongSubmissionDate,BelongSubmissionChannel,LastSubmissionDate,LastSubmissionChannel,CreatedTime,Status,RecruitRequirementId
ITALENT_RESUME_MODULES=ApplicantObjective,ApplicantEducation,ApplicantWorkExperience,ApplicantProject,ApplicantInternship,Train,Skill,Lang,Certificate,ApplicantAwards

# ------------------------------------------------------------------------------
# 8. 邮件发送配置 (SMTP & Review Email)
# ------------------------------------------------------------------------------
# 负责人邮件中展示的审核根地址（内部直接暴露端口时填服务器 IP，如 http://192.168.1.100:8000）
PUBLIC_REVIEW_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=智筛招聘 <smart-screening@example.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 端口一般启用 TLS；465 端口一般启用 SSL (EMAIL_USE_SSL=true, EMAIL_USE_TLS=false)
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20

# ------------------------------------------------------------------------------
# 9. 备份与 OCR (Operations & OCR)
# ------------------------------------------------------------------------------
# 数据库加密备份密码（执行备份前必填）
BACKUP_ENCRYPTION_PASSWORD=replace-with-backup-encryption-password
# Tesseract 路径（Linux 容器环境已内置无需配置，Windows 本地开发如有需要可配置）
TESSERACT_CMD=

